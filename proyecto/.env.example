# Configuración Base de Datos LOCAL (Docker)
# Copia este archivo como .env y ajusta según tu entorno

# Base de datos - Docker Local (por defecto)
DB_PORT=3310
DB_HOST="localhost"
DB_USERNAME="admin"
DB_PASSWORD="admin"
DB_DATABASE="proyecto"

# Base de datos - Aiven Cloud (producción)
# DB_PORT=16357
# DB_HOST="mysql-XXXXX.aivencloud.com"
# DB_USERNAME="avnadmin"
# DB_PASSWORD="tu_password_aqui"
# DB_DATABASE="defaultdb"

# Configuración de la aplicación
PORT=3000
DB_TYPE="mysql"
DB_SSL="false"

# JWT
JWT_SECRET="228781ee50d64445a5378251bd44525a"
JWT_EXPIRATION_ACCESS="60s"
JWT_EXPIRATION_REFRESH="7d"

# Sistema
PUNTO_VENTA_ACTIVO_ID=2
